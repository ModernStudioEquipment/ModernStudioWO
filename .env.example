# Copy to .env and fill in from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# Leave these BLANK to run the app in local/offline demo mode
# (in-browser localStorage, seeded with sample orders, single machine only).
# Set them to connect the real multi-user Postgres backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The CNC Catalog's AI (check a program, rewrite one). Server side only: set it
# in Vercel, never in a VITE_ variable. Without it the AI buttons say it's off.
ANTHROPIC_API_KEY=
# Optional: CNC_AI_MODEL (default claude-fable-5-2), CNC_AI_EFFORT (default high)
